# Copiază fișierul în .env și completează valorile. Nu pune .env în git!

# Conexiunea la PostgreSQL (utilizator, parolă, gazdă, port, bază)
DATABASE_URL=postgres://meals:SCHIMBA_PAROLA@localhost:5432/meals

# Fusul orar folosit pentru „azi” și săptămâna curentă
APP_TZ=Europe/Chisinau

# Unde se salvează pozele rețetelor
UPLOAD_DIR=./data/uploads

# Dimensiunea maximă a unei cereri (pozele se micșorează în browser, dar lăsăm loc)
BODY_SIZE_LIMIT=10M

# Portul serverului Node
PORT=3000
