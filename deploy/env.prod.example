# /opt/meals/.env pe server — NU se pune în git.
# Parola se generează pe server, de ex.: openssl rand -base64 24
DATABASE_URL=postgres://meals:PAROLA_GENERATA@NUME_CONTAINER_POSTGRES:5432/meals
SHARED_NETWORK=NUMELE_RETELEI_DOCKER
APP_TZ=Europe/Chisinau
BODY_SIZE_LIMIT=10M
# Imaginea folosită (CI o setează la versiunea publicată)
MEALS_IMAGE=ghcr.io/ionnuca/meals:latest
